# ============================================================
# Edge Design Division — API 키 (가진 것만 채우세요. 없으면 드라이런 동작)
# ============================================================

# 두뇌 (기획/카피/검수) — Claude
ANTHROPIC_API_KEY=

# 보조 두뇌 / 이미지 (선택) — OpenAI (GPT-image)
OPENAI_API_KEY=

# 포토리얼 제품·공간 연출 — Google (Imagen / Gemini "Nano Banana")
GOOGLE_API_KEY=

# 워크호스 생성·편집 — Flux (Black Forest Labs / fal.ai / Replicate)
FAL_KEY=
BFL_API_KEY=

# 한글 카피 박힌 배너 — Ideogram
IDEOGRAM_API_KEY=

# 피팅모델 착장 — FASHN.ai (fal.ai 경유 가능)
FASHN_API_KEY=

# 누끼·배경·4K — Claid.ai / Photoroom
CLAID_API_KEY=
PHOTOROOM_API_KEY=

# ------------------------------------------------------------
# 네이버 API (scout·seo·operator 용) — 봇차단 없이 순위/키워드 수집
#   발급: https://developers.naver.com → 애플리케이션 등록 → "검색" API
# ------------------------------------------------------------
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ------------------------------------------------------------
# 카카오톡 '나에게 보내기' — 비서실 아침 8:30 카톡 보고(secretary)
#   세팅법: business-ops/secretary/README.md
#   REST키만 채우고 authorize-url→exchange 하면 REFRESH_TOKEN 자동 저장됨
# ------------------------------------------------------------
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=https://localhost
KAKAO_REFRESH_TOKEN=

# ------------------------------------------------------------
# 타입캐스트(Typecast) — 음성 브리핑(JARVIS voice, 선택)
#   보이스 id 조회: python business-ops/secretary/tools/voice_brief.py actors
# ------------------------------------------------------------
TYPECAST_API_KEY=
TYPECAST_ACTOR_ID=

# ------------------------------------------------------------
# 모델 ID 오버라이드 (선택 — 비우면 코드 기본값 사용)
# ------------------------------------------------------------
ANTHROPIC_MODEL=claude-opus-4-8
