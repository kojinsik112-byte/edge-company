<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title>{{ brief.brand }} {{ brief.name }}</title>
<style>
  :root { --ink:#1c1e26; --muted:#6b7280; --line:#e6e8ee; --accent:#0f62fe; --bg:#fff; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Pretendard","Apple SD Gothic Neo","Malgun Gothic",sans-serif;
         color: var(--ink); background: #f4f5f7; }
  .page { max-width: 860px; margin: 0 auto; background: var(--bg); }
  .sec { padding: 64px 48px; border-bottom: 1px solid var(--line); }
  .sec img { width: 100%; border-radius: 14px; display: block; }
  .eyebrow { color: var(--accent); font-weight: 700; letter-spacing: .12em;
             font-size: 13px; text-transform: uppercase; }
  h1 { font-size: 40px; line-height: 1.25; margin: 14px 0 18px; }
  h2 { font-size: 28px; line-height: 1.3; margin: 0 0 14px; }
  p.body { font-size: 17px; line-height: 1.8; color: #353842; }
  .hero { text-align: center; padding-top: 80px; }
  .hero h1 { font-size: 46px; }
  /* 스펙 인포그래픽 */
  .metrics { display: flex; gap: 16px; margin-top: 28px; }
  .metric { flex: 1; background: #0c0e14; color: #fff; border-radius: 16px;
            padding: 28px 20px; text-align: center; }
  .metric .v { font-size: 38px; font-weight: 800; }
  .metric .u { font-size: 14px; color: #9aa3b2; }
  .metric .l { font-size: 14px; color: #c8cfdb; margin-top: 8px; }
  /* 스펙표 */
  table { width: 100%; border-collapse: collapse; margin-top: 18px; }
  td { padding: 14px 12px; border-bottom: 1px solid var(--line); font-size: 16px; }
  td.k { color: var(--muted); width: 38%; }
  .cta { text-align: center; background: var(--accent); color: #fff; }
  .cta h2 { color: #fff; }
  .btn { display: inline-block; margin-top: 18px; background: #fff; color: var(--accent);
         font-weight: 700; padding: 16px 40px; border-radius: 999px; font-size: 18px; }
  .trust .badges { display:flex; gap:12px; justify-content:center; margin-top:18px; }
  .badge { border:1px solid var(--line); border-radius:999px; padding:10px 18px; color:var(--muted); }
</style>
</head>
<body>
<div class="page">
{% for sec in sections %}
  {% if sec.kind == "hero" %}
  <section class="sec hero">
    <div class="eyebrow">{{ brief.brand }}</div>
    <h1>{{ sec.title or brief.name }}</h1>
    {% if sec.body %}<p class="body">{{ sec.body }}</p>{% endif %}
    {% if sec.image_path %}<img src="{{ sec.image_path }}" alt="{{ brief.name }}" style="margin-top:28px">{% endif %}
  </section>

  {% elif sec.kind == "infographic" %}
  <section class="sec">
    {% if sec.title %}<h2>{{ sec.title }}</h2>{% endif %}
    <div class="metrics">
      {% for m in sec.data.get("metrics", []) %}
      <div class="metric">
        <div class="v">{{ m.value }}<span class="u"> {{ m.unit }}</span></div>
        <div class="l">{{ m.label }}</div>
      </div>
      {% endfor %}
    </div>
  </section>

  {% elif sec.kind == "spec" %}
  <section class="sec">
    <div class="eyebrow">SPEC</div>
    <h2>{{ sec.title or "상세 스펙" }}</h2>
    <table>
      {% for k, v in sec.data.get("specs", {}).items() %}
      <tr><td class="k">{{ k }}</td><td>{{ v }}</td></tr>
      {% endfor %}
    </table>
  </section>

  {% elif sec.kind == "trust" %}
  <section class="sec trust" style="text-align:center">
    <h2>{{ sec.title or "믿고 쓰는 이유" }}</h2>
    {% if sec.body %}<p class="body">{{ sec.body }}</p>{% endif %}
    <div class="badges">
      <span class="badge">KC 인증</span><span class="badge">A/S 보증</span><span class="badge">정품</span>
    </div>
  </section>

  {% elif sec.kind == "cta" %}
  <section class="sec cta">
    <h2>{{ sec.title or "지금 만나보세요" }}</h2>
    {% if sec.body %}<p class="body" style="color:#e8eefc">{{ sec.body }}</p>{% endif %}
    <span class="btn">구매하러 가기</span>
  </section>

  {% else %}
  <section class="sec">
    {% if sec.kind == "feature" %}<div class="eyebrow">POINT</div>{% endif %}
    {% if sec.title %}<h2>{{ sec.title }}</h2>{% endif %}
    {% if sec.body %}<p class="body">{{ sec.body }}</p>{% endif %}
    {% if sec.image_path %}<img src="{{ sec.image_path }}" alt="{{ sec.title }}" style="margin-top:20px">{% endif %}
  </section>
  {% endif %}
{% endfor %}
</div>
</body>
</html>
